{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // The preload runs in the renderer's context, so it genuinely has a DOM —
    // it is the only place that can stamp the theme before the first paint.
    // It gets its own project rather than DOM being added to the main one,
    // where a stray `document` would typecheck and then fail at runtime.
    "lib": ["ES2023", "DOM"],
    "types": ["node", "electron-vite/node"],
    "strict": true,
    "noUnusedLocals": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"]
    }
  },
  "include": ["src/preload/**/*", "src/shared/**/*"]
}
